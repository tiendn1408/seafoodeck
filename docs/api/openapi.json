            "type": "string",
            "description": "Account sessions only."
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "description": "Account sessions only."
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "Account sessions only."
          }
        },
        "required": [
          "role",
          "internal",
          "csrf",
          "expiresAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
