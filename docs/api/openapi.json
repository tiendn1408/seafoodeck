  "info": {
    "title": "Seafood Deck API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "seafoodeck_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "credential"
        ]
      },
      "NameResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "pronunciation": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "kind",
          "label",
          "source",
          "pronunciation"
        ]
      },
      "MediaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "nameKind": {
            "type": "object",
            "nullable": true
          },
          "approved": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "role",
          "nameKind",
          "approved"
        ]
      },
      "CatalogItemResponse": {
        "type": "object",
        "properties": {
          "revisionId": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NameResponse"
            }
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identification": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaResponse"
            }
          }
        },
        "required": [
          "revisionId",
          "externalId",
          "sku",
          "group",
          "names",
          "forms",
          "identification",
          "note",
          "media"
        ]
      },
      "CatalogPageResponse": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string"
          },
          "internal": {
            "type": "boolean"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItemResponse"
            }
          }
        },
        "required": [
          "releaseId",
          "internal",
          "page",
          "limit",
          "total",
          "items"
        ]
      },
      "SignedUrlResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "expiresIn"
        ]
      },
      "StartDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "flashcard",
              "match",
              "image",
              "hs",
              "full",
              "review",
              "listening"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "en",
              "ja",
              "scientific"
            ]
          },
          "revisionId": {
            "type": "string"
          },
          "reviewOf": {
            "type": "string"
          },
          "reviewTargets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "mode"
        ]
      },
      "OptionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "ScoreResponse": {
        "type": "object",
        "properties": {
          "answered": {
            "type": "boolean"
          },
          "skipped": {
            "type": "boolean"
          },
          "correct": {
            "type": "boolean"
          },
          "selfRated": {
            "type": "boolean"
          },
          "questionId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "contentVersion": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "correctOption": {
            "type": "string"
          },
          "correctPairs": {
            "type": "object"
          }
        },
        "required": [
          "answered",
          "skipped",
          "correct",
          "selfRated",
          "questionId",
          "targetId",
          "skill",
          "contentVersion",
          "at",
          "explanation"
        ]
      },
      "QuestionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "front": {
