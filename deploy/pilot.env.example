# Generate real local secrets with: node scripts/init-pilot.mjs
# Never copy these placeholders into a running stack.
POSTGRES_DB=seafoodeck
POSTGRES_USER=seafoodeck
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql://seafoodeck:REPLACE_WITH_RANDOM_SECRET@db:5432/seafoodeck
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=seafoodeck-private
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
PUBLIC_ORIGIN=http://127.0.0.1:18089
# Staff (Studio) origin. Set => staff roles sign in only here, learners only on PUBLIC_ORIGIN. Unset => one origin for all roles.
STUDIO_ORIGIN=http://localhost:18090
S3_PUBLIC_ENDPOINT=http://127.0.0.1:18089
SITE_ADDRESS=:80
# Caddy address of the Studio site. Local: plain HTTP on container port 8090, published as 127.0.0.1:STUDIO_WEB_PORT.
# VPS: the studio host name, e.g. STUDIO_SITE_ADDRESS=seafoodeckstudio.tiendn.io.vn (see docs/DEPLOY_STUDIO_HOST.md).
# Unset: the Studio app is not served.
STUDIO_SITE_ADDRESS=http://localhost:8090
WEB_PORT=18089
# Local compose.yaml only (loopback port of the Studio site); compose.pilot.ghcr.yaml (VPS) publishes no Studio port.
STUDIO_WEB_PORT=18090
COOKIE_SECURE=false
ALLOW_INTERNAL_DEMO=true
# Swagger UI /api/v1/docs and /api/v1/openapi.json: off unless exactly true. Keep off on any shared host.
EXPOSE_API_DOCS=false
LEARNER_INVITE_CODE=REPLACE_WITH_RANDOM_INVITE
ADMIN_USERNAME=owner
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
SIGNED_URL_TTL_SECONDS=120
AUTH_TTL_HOURS=24
GAME_TTL_MINUTES=120

API_IMAGE_REF=ghcr.io/tiendn1408/seafoodeck-api@sha256:aeb492c92ed597e728fe82e2dbc7ad138558a41c674bbabe983ac55b94b468e2
# Web tier: three images (edge, learner app, Studio app). Replace the tags with the digests printed by
# scripts/publish-pilot.sh (ghcr.io/tiendn1408/seafoodeck-<name>@sha256:...).
EDGE_IMAGE_REF=ghcr.io/tiendn1408/seafoodeck-edge:pilot-internal-20261118-r2
LEARNER_IMAGE_REF=ghcr.io/tiendn1408/seafoodeck-web-learner:pilot-internal-20261118-r2
STUDIO_IMAGE_REF=ghcr.io/tiendn1408/seafoodeck-web-studio:pilot-internal-20261118-r2
