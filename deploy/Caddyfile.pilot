{$SITE_ADDRESS::80} {
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow"
    }
    # Defence in depth: the API serves its Swagger UI / OpenAPI JSON only with EXPOSE_API_DOCS=true,
    # and never through this public proxy. Path handles sort before /api/* (more specific).
    handle /api/v1/docs* {
        respond 404
    }
    handle /api/v1/openapi* {
        respond 404
    }
    handle /api/* {
        reverse_proxy api:3000
    }
    # Preserve path and Host: both are part of S3 signatures. No listing URL is signed.
    handle /{$S3_BUCKET:seafoodeck-private}/* {
        reverse_proxy storage:8333
    }
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
http://127.0.0.1:8080 {
    respond /healthz "ok" 200
}
