# Edge (phase 2.5e web tier split): TLS, security headers, compression, /api/* -> api:3000, the S3 path proxy
# and the Studio-unconfigured guard. Everything else goes to the static container of the host:
# learner site -> web-learner:80, Studio site -> web-studio:80 (deploy/web/Caddyfile). No app files here.

(security_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        X-Robots-Tag "noindex, nofollow"
    }
    # Cache-Control, two cases. reverse_proxy appends upstream headers to the ones already set, so:
    # - /api/* and the S3 proxy: no-store set before proxying, exactly as the single web container did
    #   (the API's own no-store is appended, as before).
    # - everything else comes from the static container: no-store only where it sent no Cache-Control
    #   (`?` = set if absent, applied when the response is written), so its immutable /assets/* value
    #   survives and index.html / SPA routes stay no-store.
    @edge_answered path /api/* /{$S3_BUCKET:seafoodeck-private}/*
    header @edge_answered Cache-Control "no-store"
    @from_app not path /api/* /{$S3_BUCKET:seafoodeck-private}/*
    header @from_app ?Cache-Control "no-store"
    # The single container served app files itself, without a Via header; keep it that way (the API and
    # S3 proxy responses keep the Via they always had).
    header @from_app -Via
}

# S3 path proxy, then the host's static container; identical on both sites (each with its own upstream).
(storage_and_app) {
    # Preserve path and Host: both are part of S3 signatures. No listing URL is signed.
    handle /{$S3_BUCKET:seafoodeck-private}/* {
        reverse_proxy storage:8333
    }
    handle {
        reverse_proxy {args[0]}
    }
}

# Learner site. Serves only the learner build; staff API surface answers like a path that does not exist.
{$SITE_ADDRESS::80} {
    encode zstd gzip
    import security_headers
    handle /api/* {
        # Staff API paths (admin, manager, docs/openapi) must answer exactly like an unknown path on
        # this host. Caddy only marks the request; the API (apps/api/src/learner-edge.ts) turns staff
        # paths into an unknown route after its body parser and before routing, so the 404 comes from
        # the very same pipeline as any unknown path. `header_up` overwrites any client-sent X-Edge.
        # The API container has no published port: Caddy is its only way in.
        reverse_proxy api:3000 {
            header_up X-Edge learner
        }
    }
    import storage_and_app web-learner:80
}

# Studio site (staff). If STUDIO_SITE_ADDRESS is unset (or set to the placeholder below), this block
# binds only to the never-routable host "studio.invalid" over plain HTTP (no certificate request) and
# closes every connection, so the Studio app is not served and the learner site never serves it.
# Local stack: STUDIO_SITE_ADDRESS=http://localhost:8090 (container port 8090, published on
# 127.0.0.1:${STUDIO_WEB_PORT}); VPS: the studio host name (Caddy obtains its certificate).
{$STUDIO_SITE_ADDRESS:http://studio.invalid} {
    encode zstd gzip
    import security_headers
    # Only two top-level handles so the guard is evaluated first (a named-matcher handle sorts
    # after path-matcher handles, but before the matcher-less one).
    @unconfigured expression `"{$STUDIO_SITE_ADDRESS:http://studio.invalid}" == "http://studio.invalid"`
    handle @unconfigured {
        abort
    }
    handle {
        handle /api/* {
            # Never forward a client-sent learner-edge marker from the Studio host.
            reverse_proxy api:3000 {
                header_up -X-Edge
            }
        }
        import storage_and_app web-studio:80
    }
}

http://127.0.0.1:8080 {
    respond /healthz "ok" 200
}
